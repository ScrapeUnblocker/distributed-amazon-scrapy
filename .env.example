# Copy to .env and fill in your key: https://scrapeunblocker.com/?utm_source=github&utm_medium=integration&utm_campaign=example-repos
SCRAPEUNBLOCKER_KEY=your_key_here

# Enable local routing so `scrapy crawl` reproduces Spider Cloud behaviour.
# Leave this unset when running on Spider Cloud (routing is automatic there).
SU_LOCAL_ROUTING=1
